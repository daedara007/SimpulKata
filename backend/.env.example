# ==========================================================
# SimpulKata Backend - Environment Variables Template
# Salin file ini menjadi .env di dalam folder backend/
# ==========================================================

# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL
# Lokal: postgres://admin:secretpassword@localhost:5432/simpulkata_db
# Docker Compose: postgres://admin:secretpassword@db:5432/simpulkata_db
DB_URL=postgres://admin:secretpassword@localhost:5432/simpulkata_db

# Hugging Face Inference API
# Dapatkan token gratis dari: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# Model AI
HF_WHISPER_MODEL=openai/whisper-large-v3
HF_SUMMARY_MODEL=meta-llama/Llama-3.1-8B-Instruct

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Upload Config
MAX_UPLOAD_SIZE_MB=200
UPLOAD_DIR=storage/uploads

# Resend Email Service (Verifikasi Email OTP - SRS UC-01)
# Dapatkan API key dari: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=SimpulKata <onboarding@resend.dev>

# Midtrans Payment Gateway Sandbox (SRS UC-13 & UC-14)
# Dapatkan dari: https://dashboard.sandbox.midtrans.com/settings/access_keys (Tab General)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_here
MIDTRANS_IS_PRODUCTION=false
